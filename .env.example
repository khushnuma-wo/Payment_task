# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
POSTGRES_DB=payment

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# JWT (used to protect the live-update websocket handshake)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# Payment gateway webhook signing
WEBHOOK_SECRET=change-me-webhook-shared-secret

# Locking strategy: 'pessimistic' | 'optimistic'
LOCKING_STRATEGY=pessimistic

# Poller for stuck processing payments (cron-ish interval in ms)
STUCK_PAYMENT_SCAN_MS=60000
STUCK_PAYMENT_MAX_AGE_MS=300000

# Whether to enable the websocket live layer (set false when Redis absent in dev)
WEBSOCKET_ENABLED=true